{
  "schema_version": 1,
  "product": "ScanSci",
  "version": "0.4.2",
  "scope_file": "config/release-scope.json",
  "negative_checklist": "docs/desktop-delivery-negative-checklist.zh.md",
  "targeted_commands": [
    {
      "id": "pi-runtime-build",
      "title": "构建当前 worktree 的 Pi sidecar bundle",
      "command": [
        "npm.cmd",
        "run",
        "build:pi-runtime"
      ],
      "console": "log"
    },
    {
      "id": "pi-targeted-python",
      "title": "Pi 协议、工具、Skill、上下文、子代理、MCP 与安全回归",
      "command": [
        "{python}",
        "-m",
        "pytest",
        "tests/test_agent_contract.py",
        "tests/test_task_contract.py",
        "tests/test_agent_capabilities.py",
        "tests/test_pi_capability_matrix.py",
        "tests/test_pi_runtime_protocol.py",
        "tests/test_skill_runtime.py",
        "tests/test_pi_parallel.py",
        "tests/test_pi_observability.py",
        "tests/test_context_policy.py",
        "tests/test_pi_multimodal.py",
        "tests/test_image_attachments.py",
        "tests/test_vision_routing.py",
        "tests/test_pi_subagents.py",
        "tests/test_mcp_bridge.py",
        "tests/test_pi_security.py",
        "tests/test_pi_agent.py",
        "tests/test_scansci_harness.py",
        "-q",
        "--junitxml",
        "{diagnostics}/pi-targeted-junit.xml"
      ],
      "result_file": "pi-targeted-junit.xml",
      "result_kind": "pytest_junit",
      "output": "file"
    },
    {
      "id": "pi-capability-matrix",
      "title": "Pi 10 轴能力矩阵结构与门槛",
      "command": [
        "{python}",
        "scripts/verify_pi_capabilities.py",
        "--validate-matrix-only",
        "--output",
        "{diagnostics}/pi-capability-matrix.json"
      ],
      "result_file": "pi-capability-matrix.json",
      "result_kind": "pi_matrix_validation",
      "console": "log"
    },
    {
      "id": "pi-capabilities-deterministic",
      "title": "真实 Pi sidecar 确定性工具循环与能力证据",
      "command": [
        "{python}",
        "scripts/verify_pi_capabilities.py",
        "--mode",
        "deterministic",
        "--workspace",
        "{diagnostics}/pi-capability-workspace.sqlite",
        "--test-evidence",
        "{diagnostics}/pi-targeted-junit.xml",
        "--output",
        "{diagnostics}/pi-capabilities-deterministic.json"
      ],
      "result_file": "pi-capabilities-deterministic.json",
      "result_kind": "pi_capability_report",
      "console": "log",
      "timeout_seconds": 180
    },
    {
      "id": "targeted-python",
      "title": "桌面、对话、模型、Skill 与交付路径针对性测试",
      "command": [
        "{python}",
        "-m",
        "pytest",
        "tests/test_desktop.py",
        "tests/test_webapp.py",
        "tests/test_llm.py",
        "tests/test_skill_manager.py",
        "tests/test_library_manager.py",
        "tests/test_slides_templates.py",
        "tests/test_pi_release_contract.py",
        "tests/test_release_gate.py",
        "tests/test_verify_scansci_knowledge.py",
        "tests/test_build_profiles.py",
        "tests/test_archive_runtime_component.py",
        "tests/test_archive_binary_component.py",
        "tests/test_prepare_runtime_release_manifest.py",
        "tests/test_local_runtime_component.py",
        "tests/test_local_runtime_isolation.py",
        "tests/test_local_transformers_compat.py",
        "tests/test_package_desktop_release.py",
        "tests/test_runtime_identity.py",
        "tests/test_verify_update_channel.py",
        "tests/test_direct_chat_queue_ui.py",
        "tests/test_direct_chat_history.py",
        "tests/test_image_generation.py",
        "tests/test_app_settings.py",
        "tests/test_direct_chat_recovery_ui.py",
        "tests/test_dark_theme_css_contract.py",
        "tests/test_research_tools.py",
        "tests/test_research_runs.py",
        "-q"
      ],
      "retry": {
        "max_attempts": 2,
        "delay_seconds": 1,
        "failure_reason": "test_notebook_webapp_tests_saved_mcp_connection_and_reports_tools"
      },
      "output": "file"
    },
    {
      "id": "frontend-syntax",
      "title": "前端脚本语法检查",
      "command": [
        "node",
        "--check",
        "src/scansci_html/web/app.js"
      ]
    },
    {
      "id": "gateway-worker-tests",
      "title": "托管模型网关单元测试",
      "command": [
        "npm.cmd",
        "--prefix",
        "{project_root}/services/scansci-glm-gateway",
        "test"
      ]
    },
    {
      "id": "gateway-worker-dry-run",
      "title": "托管模型网关部署前配置校验",
      "command": [
        "npm.cmd",
        "--prefix",
        "{project_root}/services/scansci-glm-gateway",
        "run",
        "check"
      ],
      "console": "log"
    },
    {
      "id": "agent-harness-schema",
      "title": "Scientific agent harness schema",
      "command": [
        "{python}",
        "scripts/run_agent_harness.py",
        "--validate-only",
        "--output",
        "{diagnostics}/agent-harness-schema.json"
      ],
      "result_file": "agent-harness-schema.json",
      "console": "log"
    },
    {
      "id": "internal-beta-contracts",
      "title": "内测五条核心用户链路契约",
      "command": [
        "{python}",
        "scripts/verify_internal_beta.py",
        "--output",
        "{diagnostics}/internal-beta-contracts.json"
      ],
      "result_file": "internal-beta-contracts.json",
      "console": "log"
    },
    {
      "id": "frontend-browser-submit",
      "title": "真实浏览器多轮、队列、编辑、滚动与并行对话回归",
      "command": [
        "{python}",
        "scripts/verify_scansci_frontend.py",
        "--output",
        "{diagnostics}/frontend-browser-submit.json"
      ],
      "result_file": "frontend-browser-submit.json",
      "console": "log"
    }
  ],
  "full_commands": [
    {
      "id": "full-python",
      "title": "完整 Python 测试套件",
      "command": [
        "{python}",
        "-m",
        "pytest",
        "-q"
      ],
      "output": "file"
    }
  ],
  "real_verifications": [
    {
      "id": "pi-capabilities-real",
      "title": "真实 provider 动态工具序列化与多模态 Pi 证据",
      "command": [
        "{python}",
        "scripts/verify_pi_capabilities.py",
        "--mode",
        "real",
        "--workspace",
        "{diagnostics}/pi-capability-real-workspace.sqlite",
        "--test-evidence",
        "{diagnostics}/pi-targeted-junit.xml",
        "--output",
        "{diagnostics}/pi-capabilities-real.json"
      ],
      "result_file": "pi-capabilities-real.json",
      "result_kind": "pi_capability_report",
      "console": "log",
      "timeout_seconds": 1800
    },
    {
      "id": "dual-model-agent",
      "title": "ScanSci 托管默认模型、流式输出与 Skill 验证",
      "command": [
        "{python}",
        "scripts/verify_scansci_agent.py",
        "--output",
        "{diagnostics}/agent-e2e.json"
      ],
      "result_file": "agent-e2e.json",
      "console": "log",
      "retry": {
        "max_attempts": 3,
        "delay_seconds": 120,
        "failure_reason": "provider_rate_limited"
      },
      "timeout_seconds": 240
    },
    {
      "id": "knowledge-e2e",
      "title": "真实资料库导入、检索、证据阅读与 Agent 验证",
      "command": [
        "{python}",
        "scripts/verify_scansci_knowledge.py",
        "--source",
        "{knowledge_source}",
        "--limit",
        "8",
        "--with-model",
        "--model",
        "glm-4.7-flash",
        "--output",
        "{diagnostics}/knowledge-e2e.json"
      ],
      "result_file": "knowledge-e2e.json",
      "console": "log",
      "retry": {
        "max_attempts": 3,
        "delay_seconds": 120,
        "failure_reason": "provider_rate_limited"
      },
      "timeout_seconds": 240
    }
  ],
  "package": {
    "mode": "onedir",
    "name": "ScanSci",
    "profile": "core",
    "signature_required": true,
    "release_public_key": "",
    "release_key_id": "scansci-release-v1",
    "update_manifest_url": "https://github.com/Rimagination/scansci-pi/releases/latest/download/stable.json",
    "update_package_url": "https://github.com/Rimagination/scansci-pi/releases/download/v{version}/ScanSci-{version}-windows-x64.zip",
    "runtime_manifest_url": "https://github.com/Rimagination/scansci-portal/releases/download/local-runtime-v1.0.0/local-transformers.json",
    "node_component_manifest_url": "https://github.com/Rimagination/scansci-portal/releases/download/runtime-components-v1/node.json",
    "tectonic_component_manifest_url": "https://github.com/Rimagination/scansci-portal/releases/download/runtime-components-v1/tectonic.json",
    "exclude_runtimes": true,
    "max_package_bytes": 450000000,
    "forbidden_top_level_resources": [
      "torch",
      "transformers",
      "sentence_transformers",
      "tensorflow"
    ],
    "required_resources": [
      "scansci_html/web/index.html",
      "scansci_html/web/styles.css",
      "scansci_html/web/app.js",
      "scansci_html/builtin_skill_assets/good-question/SKILL.md",
      "scansci_html/builtin_skill_assets/good-story/SKILL.md",
      "scansci_html/builtin_skill_assets/evidence-retrieval/SKILL.md",
      "scansci_html/builtin_skill_assets/web-access/SKILL.md",
      "scansci_html/build-info.json",
      "pi_runtime/main.mjs"
    ]
  },
  "visual_acceptance": {
    "evidence_file": "visual-evidence.json",
    "required_checks": [
      "enter_send",
      "button_send",
      "general_chat_hides_references",
      "knowledge_chat_shows_references",
      "taskbar_visible_when_maximized",
      "window_restore_correct",
      "home_layout_checked",
      "chat_layout_checked"
    ],
    "required_screenshots": [
      "home.png",
      "chat.png",
      "maximized.png"
    ]
  }
}
